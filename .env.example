# Public browser settings from Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
# Legacy fallback if your project has not migrated to publishable keys:
# VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Private server settings. Add these only to Netlify environment variables.
# Never expose the secret key with a VITE_ prefix or commit the real value.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-private-server-key
# Legacy fallback if your project has not migrated to secret keys:
# SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key

# Optional: enables realistic sample records in the local Vite admin preview.
# This is ignored in production builds.
VITE_ADMIN_DEMO=false

# Optional WhatsApp Business notification settings.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=new_quote_request
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_RECIPIENT_NUMBER=923452801957
